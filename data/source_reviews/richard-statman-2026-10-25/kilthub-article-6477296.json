{"files": [{"id": 11909192, "name": "file.pdf", "size": 1183192, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/11909192", "supplied_md5": "8bcdfd0d79cac30cc7f7a67ad9d778b1", "computed_md5": "8bcdfd0d79cac30cc7f7a67ad9d778b1", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 5364608, "full_name": "Richard  Statman", "first_name": "Richard", "last_name": "Statman", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "Publisher Statement", "value": "All Rights Reserved", "settings": {"validations": {"min_length": 2, "max_length": 2000}, "placeholder": "Add the text and full citation to the published version."}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Date", "value": "1996-01-01", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}], "figshare_url": "https://kilthub.cmu.edu/articles/journal_contribution/Effective_reduction_and_conversion_strategies_for_combinators/6477296", "download_disabled": false, "description": "Abstract: \"We shall prove the following results concerning effective reduction and conversion strategies for combinators. (1) There is an effective one-step cofinal reduction strategy (answering a question of Barendregt [2] 13.6.6). (2) There is no effective confluence function but there is an effective one-step confluence strategy (answering a question of Isles reported in [1]). (3) There is an effective one-step enumeration strategy (answering an obvious question). (4) There is an effective one-step Church-Rosser conversion strategy ('almost' answering a question of Bergstra and Klop [3]).\"", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1183192, "created_date": "2018-06-29T18:20:12Z", "modified_date": "2026-03-09T07:46:21Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 43, "n